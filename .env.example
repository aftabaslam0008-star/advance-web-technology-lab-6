# Application Environment Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Multi-Tenancy Configuration
JWT_SECRET=super-secret-saas-tenant-key-2026
DEFAULT_TENANT_ID=tenant-alpha

# Database Connection Pooling Configuration (PostgreSQL)
DB_USE_EMBEDDED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas_multitenant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# pg-pool Configuration (Lecture 17)
DB_POOL_MAX=20
DB_POOL_MIN=4
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=3000

# Apache Kafka Configuration (Lecture 18)
KAFKA_ENABLED=false
KAFKA_CLIENT_ID=saas-order-service
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_ORDERS=tenant.orders
KAFKA_GROUP_ID=order-processing-group
